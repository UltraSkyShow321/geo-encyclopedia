# 高德地图 JS API Key + 安全密钥（可选，地图页新增"高德"底图；注册: https://lbs.amap.com 免费个人key）
# Key: 控制台 → 应用管理 → 创建应用 → 添加Key(Web端JS API)
# 安全密钥: 同一页面下方的"安全密钥"里复制 jscode（用 jscode 方案可免配域名白名单）
AMAP_KEY=
AMAP_SECURITY_CODE=

# 管理员密码（登录收藏/笔记/后台用，必改）
ADMIN_PASSWORD=change-me-to-a-strong-password
# 服务端口（容器内）
PORT=3000
# LLM 内容生成（DeepSeek 或任何 OpenAI 兼容接口）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat
